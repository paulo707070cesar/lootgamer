Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php
RewriteEngine On

# HTTPS obrigatório em produção (ative removendo o # após configurar o SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteRule ^categoria/([a-z0-9\-]+)/?$ categoria.php?slug=$1 [L,QSA]
RewriteRule ^produto/([a-z0-9\-]+)/?$ produto.php?slug=$1 [L,QSA]
RewriteRule ^ofertas/?$ ofertas.php [L,QSA]
RewriteRule ^novidades/?$ novidades.php [L,QSA]
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog/categoria/([a-z0-9\-]+)/?$ blog.php?cat=$1 [L,QSA]
RewriteRule ^blog/([a-z0-9\-]+)/?$ blog-post.php?slug=$1 [L,QSA]
RewriteRule ^busca/?$ busca.php [L,QSA]
RewriteRule ^lojas/?$ lojas.php [L,QSA]
RewriteRule ^contato/?$ contato.php [L,QSA]
RewriteRule ^(sobre|privacidade|termos|cookies|divulgacao-afiliados|como-funciona|faq)/?$ pagina.php?slug=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^ir/([0-9]+)/?$ go.php?id=$1 [L,QSA]

<FilesMatch "(^\.|\.(sql|log|md|sample\.php)$)">
Require all denied
</FilesMatch>
<FilesMatch "^(\.gitignore)$">
Require all denied
</FilesMatch>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
